spring:
  application:
    name: lab-archivistica-backend
  datasource:
    url: jdbc:postgresql://localhost:5432/lab_archivistica
    username: tu_usuario
    password: tu_password
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB

server:
  port: 8080
  servlet:
    context-path: /api

app:
  jwt-secret: "clave-minimo-32-caracteres"
  jwt-expiration: 86400000
  upload-dir: /var/www/lab-archivistica/documentos/